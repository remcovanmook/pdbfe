# Template for pdbfe-graphql worker. Copy to wrangler-graphql.toml and fill in IDs.
name = "pdbfe-graphql"
main = "graphql/index.js"
compatibility_date = "2026-03-18"
workers_dev = true

rules = [
  { type = "Text", globs = ["**/*.html", "**/*.css"], fallthrough = true },
  { type = "Data", globs = ["**/*.woff2"], fallthrough = true }
]

routes = [
  { pattern = "graphql.<your-domain>/*", zone_name = "<your-domain>" },
  { pattern = "api.<your-domain>/graphql", zone_name = "<your-domain>" }
]

[[d1_databases]]
binding = "PDB"
database_name = "peeringdb"
database_id = "<your-d1-database-id>"

[[kv_namespaces]]
binding = "SESSIONS"
id = "<your-sessions-kv-namespace-id>"

[[d1_databases]]
binding = "USERDB"
database_name = "pdbfe-users"
database_id = "<your-users-d1-database-id>"

[vars]
PDBFE_VERSION = "<your-version>"

# Rate limiting (core/gate.js): Workers rate-limit bindings, counted per
# Cloudflare location across all of this worker's isolates. Approximate:
# they stop floods, they are not accounting. RL_AUTH is keyed by the API key
# or session, RL_ANON by the caller's IP (IPv6 /64). Namespace ids are
# unique per account; each worker has its own budget.
[[ratelimits]]
name = "RL_ANON"
namespace_id = "1005"
simple = { limit = 30, period = 60 }

[[ratelimits]]
name = "RL_AUTH"
namespace_id = "1006"
simple = { limit = 300, period = 60 }

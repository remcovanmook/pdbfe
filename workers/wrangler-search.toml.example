# Template for pdbfe-search worker. Copy to wrangler-search.toml and fill in IDs.
name = "pdbfe-search"
main = "search/index.js"
compatibility_date = "2026-03-18"
workers_dev = true

routes = [
  { pattern = "api.<your-domain>/search*", zone_name = "<your-domain>" }
]

[[d1_databases]]
binding = "PDB"
database_name = "peeringdb"
database_id = "<your-d1-database-id>"

[[kv_namespaces]]
binding = "SESSIONS"
id = "<your-sessions-kv-namespace-id>"

[[d1_databases]]
binding = "USERDB"
database_name = "pdbfe-users"
database_id = "<your-users-d1-database-id>"

# Vectorize index — required for semantic search.
# Create with: wrangler vectorize create pdbfe-vectors --dimensions=1024 --metric=cosine
[[vectorize]]
binding = "VECTORIZE"
index_name = "<your-vectorize-index-name>"

[vars]
PDBFE_VERSION = "<your-version>"

# Workers Cache — ON. Search results are auth-independent (public entity types
# only; poc is rejected), so serveSearch marks every 200 `public` with the
# sync-aligned expiry and no Vary: one edge object serves every caller.
# Errors (400/403/429/503) are no-store and never edge-stored. Same
# cross_version_cache stance as pdbfe-api: left at false so each deploy starts
# from a cold edge cache that falls to the warm per-PoP L2.
[cache]
enabled = true

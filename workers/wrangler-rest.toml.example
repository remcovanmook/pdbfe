# Template for pdbfe-rest worker. Copy to wrangler-rest.toml and fill in IDs.
name = "pdbfe-rest"
main = "rest/index.js"
compatibility_date = "2026-03-18"
workers_dev = true

# Static asset imports (HTML/CSS as text, JSON/WOFF2 as data)
rules = [
  { type = "Text", globs = ["**/*.html", "**/*.css"], fallthrough = true },
  { type = "Data", globs = ["extracted/*.json", "**/*.woff2"], fallthrough = true }
]

routes = [
  { pattern = "rest.<your-domain>/*", zone_name = "<your-domain>" },
  { pattern = "api.<your-domain>/v1/*", zone_name = "<your-domain>" },
  { pattern = "api.<your-domain>/openapi.json", zone_name = "<your-domain>" }
]

[[d1_databases]]
binding = "PDB"
database_name = "peeringdb"
database_id = "<your-d1-database-id>"

[[kv_namespaces]]
binding = "SESSIONS"
id = "<your-sessions-kv-namespace-id>"

[[d1_databases]]
binding = "USERDB"
database_name = "pdbfe-users"
database_id = "<your-users-d1-database-id>"

[vars]
PDBFE_VERSION = "<your-version>"

# Workers Cache — ON. deploy.sh runs `wrangler deploy` without --env, so only
# this top-level [cache] block is ever applied; there is no separate production
# environment to flip. The header split gates what is edge-cacheable:
# anon responses are `public` (edge-stored), authenticated responses are
# `private` (edge BYPASS).
#
# cross_version_cache is deliberately NOT set (defaults to false): the Worker
# version stays part of the cache key, so each deploy starts from a cold *edge*
# cache and never serves a prior version's responses. This keeps gradual
# deployments safe (old/new versions have isolated caches) and avoids pinning
# immutable/openapi.json responses across schema changes. Cost is minimal — the
# L1 (60min) and L2 per-PoP tiers are not version-keyed and stay warm, so a cold
# edge cache after deploy falls to a warm L1/L2, not D1.
[cache]
enabled = true

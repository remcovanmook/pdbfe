# Cloudflare Pages headers. deploy.sh --generate-configs copies this to
# frontend/_headers (gitignored), which `wrangler pages deploy` uploads.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Vendored libraries (Leaflet, Inter): change only on a deliberate upgrade.
# /js, /css and /locales are left at the Pages default (short-lived,
# ETag-revalidated) here, which is what local dev and e2e serve.
#
# The deployed build (scripts/version_frontend.js) versions every /js, /css,
# /locales and listed /third_party URL and makes those paths immutable: it
# rewrites the Cache-Control of the rules below rather than adding new ones,
# because Pages joins the values of every rule that matches a path. So keep
# these rules non-overlapping (no /third_party/* catch-all).
#
# Leaflet's images stay unversioned: leaflet.js finds its icon path by
# matching `marker-icon.png)` at the end of the CSS url(), which a ?v= would
# break.
/third_party/inter/*
  Cache-Control: public, max-age=604800

/third_party/leaflet/leaflet.css
  Cache-Control: public, max-age=604800

/third_party/leaflet/leaflet.js
  Cache-Control: public, max-age=604800

/third_party/leaflet/images/*
  Cache-Control: public, max-age=604800

# No Content-Security-Policy yet: Cloudflare injects a per-request inline
# bot-detection script (/cdn-cgi/challenge-platform) that a static CSP can
# neither hash nor nonce, so `script-src 'self'` would block it. Adding a CSP
# needs either 'unsafe-inline' or JS detections turned off on the zone.
